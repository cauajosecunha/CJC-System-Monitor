# Porta do servidor (Conforme Mapeamento de Portas do Servidor: Faixa 4000-4099)
PORT=4080
HOST=0.0.0.0

# Intervalo de coleta e streaming WebSocket em milissegundos (padrão: 1000ms)
UPDATE_INTERVAL_MS=1000

# Chave de segurança opcional para autenticação (deixe vazio para liberar acesso na LAN)
# Se preenchido, exige header 'X-API-Key: sua-chave' no HTTP ou query '?token=sua-chave' no WebSocket
API_KEY=

# Origens permitidas para CORS
CORS_ORIGIN=*

