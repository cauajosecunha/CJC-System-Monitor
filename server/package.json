{
  "name": "cjc-system-monitor-server",
  "version": "1.0.0",
  "description": "Local Computer Stats Monitoring Server with REST and WebSocket Streaming",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:logs": "pm2 logs cjc-system-monitor-server"
  },
  "keywords": [
    "system-monitor",
    "metrics",
    "cpu",
    "gpu",
    "ram",
    "websocket"
  ],
  "author": "CJC Dev",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "systeminformation": "^5.25.11",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}

