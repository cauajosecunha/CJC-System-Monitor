<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema de Inicialização: Tela Cheia Nativa sem barras de status/título -->
    <style name="LaunchTheme" parent="@android:style/Theme.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
    <!-- Tema Normal de Execução: Tela Cheia Imersiva -->
    <style name="NormalTheme" parent="@android:style/Theme.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">?android:colorBackground</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
